
# AVA VOICE
AVA_VOICE_ENABLED=false
AVA_VOICE_MODE=audio_only
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# OMNICOMMERCE BRIDGE (Shopify) — solo backend (Render). Nunca en Vercel/frontend.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_WEBHOOK_SECRET=
# Opcional: re-verifica el pago en Shopify al aprobar
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=
# Políticas (valores por defecto entre paréntesis)
COMMERCE_GRACE_DAYS=7
COMMERCE_CANCEL_GRACE_DAYS=0
COMMERCE_SUSPEND_ON_CHARGEBACK=true
COMMERCE_SUSPEND_ON_FULL_REFUND=true
COMMERCE_AUTO_REACTIVATE=true
COMMERCE_ALLOW_TEST_ORDERS=false
COMMERCE_MAX_WEBHOOK_ATTEMPTS=5
