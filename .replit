modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "omniflow-no-spinner-flash"

[[workflows.workflow]]
name = "omniflow-no-spinner-flash"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/omniflow test"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 8083
externalPort = 3003

[[ports]]
localPort = 23312
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
# SECURITY (Fase 0.5, 2026-09-01): secrets removed from this tracked file.
# OpenAI apikey and INTEGRATION_ENCRYPTION_KEY used to live here in plain text,
# versioned since the first commit. Production reads these from Render/Vercel
# environment variables, not from .replit — set them there, never here.
# Rotation of the exposed values (and purging them from git history) is tracked
# separately and still pending as of this commit.
EMAIL_FROM = "OmniTech Core <noreply@omnitechcore.com>"

[userenv.production]
PUBLIC_URL = "https://omnitech-core.com"
